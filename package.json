{
  "name": "japan-marriage-registration",
  "version": "1.0.0",
  "private": true,
  "description": "Japan marriage registration PDF generator",
  "type": "module",
  "scripts": {
    "black:config": "node src/main.js --init-config --template black",
    "black:layout": "node src/main.js --init-layout --template black",
    "black:pdf": "node src/main.js --template black --output result-black.pdf",
    "cinnamoroll:config": "node src/main.js --init-config --template cinnamoroll",
    "cinnamoroll:layout": "node src/main.js --init-layout --template cinnamoroll",
    "cinnamoroll:pdf": "node src/main.js --template cinnamoroll --output result-cinnamoroll.pdf",
    "clean": "zsh scripts/cleanup-temp-files.sh",
    "cute": "node src/main.js --template cinnamoroll",
    "generate": "node src/main.js",
    "generate-sample": "node src/main.js config.yaml",
    "index": "zsh scripts/index.sh",
    "init-config": "node src/main.js --init-config",
    "lint": "pnpm run lint-code && pnpm run lint-md",
    "lint-code": "prettier --write .",
    "lint-md": "markdownlint-cli2 --fix",
    "red:config": "node src/main.js --init-config --template red",
    "red:layout": "node src/main.js --init-layout --template red",
    "red:pdf": "node src/main.js --template red --output result-red.pdf",
    "start": "./start.sh"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-rule-relative-links": "^5.1.2",
    "markdownlint-rule-search-replace": "^1.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.19.0",
    "sh-syntax": "^0.6.0"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
